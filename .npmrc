# GitHub Packages registry for @xtnd-dynamics scope.
#
# The token is injected via the NPM_TOKEN environment variable at install
# time — never checked in. Set it locally in your shell or in CI secrets.
#
# Local dev:
#   export NPM_TOKEN=ghp_xxx   # PAT with read:packages scope
#
# Cloudflare Pages:
#   Dashboard → Pages project → Settings → Environment variables → NPM_TOKEN
@xtnd-dynamics:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
always-auth=true
